# Backend selection — leave as "mock" to run with zero external credentials.
TRANSCRIBER_BACKEND=mock
INTENT_BACKEND=mock

# Azure Speech SDK (only needed when TRANSCRIBER_BACKEND=azure)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# OpenAI (only needed when INTENT_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Persistence
DATABASE_URL=sqlite:///./voice_to_action_points.db

# Frontend origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:5173
